diff --git a/psana/psana/tests/run_multirun.py b/psana/psana/tests/run_multirun.py
new file mode 100644
index 000000000..eec4e3b16
--- /dev/null
+++ b/psana/psana/tests/run_multirun.py
@@ -0,0 +1,57 @@
+"""Multi-run MPI: a DataSource given run=[14, 15] must deliver every event
+of both runs on the BD ranks and every rank must return (#209).
+
+Run 14 comes from setup_input_files; run 15 is written here the same way.
+xtcwriter stamps run number 14 into every BeginRun, so runs are identified
+by their order in ds.runs(), not by run.runnum.
+"""
+import os
+import subprocess
+
+import numpy as np
+from mpi4py import MPI
+
+from psana import DataSource
+
+comm = MPI.COMM_WORLD
+rank = comm.Get_rank()
+N_EVENTS = 10
+
+
+def write_run15(xtc_dir):
+    smd_dir = os.path.join(xtc_dir, "smalldata")
+    os.makedirs(smd_dir, exist_ok=True)
+    for i in range(2):
+        fname = f"xpptut15-r0015-s{i:03d}-c000.xtc2"
+        sfile = os.path.join(xtc_dir, fname)
+        if os.path.exists(sfile):
+            continue
+        subprocess.check_call(
+            ["xtcwriter", "-f", sfile, "-t", "-n", str(N_EVENTS), "-s", str(i * 2), "-e", "4", "-m", "1"]
+        )
+        subprocess.check_call(
+            ["smdwriter", "-f", sfile, "-o", os.path.join(smd_dir, fname.replace(".xtc2", ".smd.xtc2"))]
+        )
+
+
+def run_test_multirun():
+    xtc_dir = os.path.join(os.environ.get("TEST_XTC_DIR", os.getcwd()), ".tmp")
+    if rank == 0:
+        write_run15(xtc_dir)
+    comm.Barrier()
+
+    ds = DataSource(exp="xpptut15", run=[14, 15], dir=xtc_dir, batch_size=1)
+    counts = []
+    for run in ds.runs():
+        run.Detector("xppcspad")
+        counts.append(sum(1 for _ in run.events()))
+
+    assert len(counts) == 2, f"rank {rank} saw {len(counts)} runs"
+    totals = comm.allreduce(np.array(counts), op=MPI.SUM).tolist()
+    if rank == 0:
+        print(f"events per run over all ranks: {totals}")
+    assert totals == [N_EVENTS, N_EVENTS], totals
+
+
+if __name__ == "__main__":
+    run_test_multirun()
diff --git a/psana/psana/tests/test_steps_iterator_lifetime.py b/psana/psana/tests/test_steps_iterator_lifetime.py
index 8169d3978..178c54462 100644
--- a/psana/psana/tests/test_steps_iterator_lifetime.py
+++ b/psana/psana/tests/test_steps_iterator_lifetime.py
@@ -116,3 +116,31 @@ def test_control_nested_loop(cpu_run):
     for step in mpi_ds.RunParallel.steps(cpu_run):
         seen.append(_timestamps(step.events()))
     assert seen == [[1000, 1100]]
+
+
+@pytest.mark.parametrize("consume_step", [True, False])
+def test_normal_steps_exhaust_transport_with_retained_step(cpu_run, consume_step):
+    """EndRun must not leave transport cleanup waiting on the last Step.
+
+    A Python for-loop retains its last loop variable. Even when that Step
+    remains alive, completing run.steps() must advance the underlying stream
+    past EndRun, before a caller can start the next run's MPI collectives.
+    Cover both consuming the child and letting the parent skip its events.
+    """
+    from psana.psexp import mpi_ds
+
+    exhausted = []
+
+    def records():
+        yield from _records()
+        exhausted.append(True)
+
+    cpu_run.start = lambda **kwargs: records()
+    seen = []
+    for step in mpi_ds.RunParallel.steps(cpu_run):
+        if consume_step:
+            seen.extend(_timestamps(step.events()))
+
+    assert seen == ([1000, 1100] if consume_step else [])
+    assert exhausted == [True], 'normal step iteration must exhaust transport'
+    assert list(step.events()) == [], 'the retained Step is now exhausted'
